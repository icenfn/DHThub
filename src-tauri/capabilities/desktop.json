{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-default",
  "description": "DHThub 桌面端权限（Linux / Windows）",
  "windows": ["main"],
  "platforms": ["linux", "windows"],
  "permissions": [
    "core:default",
    "store:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "clipboard-manager:allow-write-text",
    "opener:default",
    "http:default",
    "shell:allow-open",
    "log:default",
    "updater:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$APPDATA/**" }, { "path": "$DOWNLOAD/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$APPDATA/**" }, { "path": "$DOWNLOAD/**" }]
    }
  ]
}
